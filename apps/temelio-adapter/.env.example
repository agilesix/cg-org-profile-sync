# Temelio adapter. Copy to `.env` (gitignored).
#
# Out of the box this runs in `fixture` mode, which needs no Temelio
# credential: the four TEMELIO_* values below are blank on purpose and only
# matter in `sandbox` mode. Everything else has a working local placeholder.
#
# Vendor detail — the API origin, the foundation, what the real records hold —
# lives in the internal spec and in SANDBOX-FINDINGS.local.md (gitignored),
# not here. This repo is public.

# `fixture` answers from an in-memory fake of Temelio's API and needs no other
# TEMELIO_* variable. `sandbox` talks to the real vendor with the three
# variables below, and a push from the widget then edits a record in a live
# system shared with other foundations — which is the point of demoing it, and
# the reason the allowlist below is the only thing it can touch. Unset means
# `fixture`.
#
# The e2e suite does not read this: it pins TEMELIO_MODE=fixture on the adapter
# it starts, so a checkout set to `sandbox` for a demo still runs the suite
# against the fake. The one thing it cannot override is an adapter already
# running in sandbox mode, which it joins and is then refused by
# `POST /__test/reset` with a sentence saying so.
TEMELIO_MODE=fixture

# Origin of Temelio's backend API, no trailing slash, no `/api`.
TEMELIO_API_ORIGIN=

# The foundation (funder) account the adapter acts as. Every reachable grantee
# route lives under it.
TEMELIO_FOUNDATION_ID=

# A foundation API key (Edit scope), created on the foundation's API Keys page.
# Sent on every request as `X-API-Key`. Not a bearer token.
TEMELIO_API_TOKEN=

# Comma-separated Temelio nonprofit ids this adapter may read and write.
# Every write is refused outside this list, whatever credential the caller
# presented. This is also what the demo admin is granted on sign-in.
TEMELIO_ORG_ALLOWLIST=

# --- The same variables the two portals carry ---

# Static service credential accepted on /common-grants/*, scoped to every org
# this adapter serves. What the curl block and the API specs use.
#
# A local-development placeholder and nothing else: a per-system credential is
# only worth having while no two systems share one anybody can read in git.
CG_ACCESS_TOKEN=temelio-local-placeholder-change-me

# This system's own ES256 signing key, as a private JWK on one line. It signs
# the access tokens this system mints and backs /.well-known/jwks.json, so a
# token minted here verifies here and nowhere else.
#
# Its own key, not a copy of a portal's: two systems sharing one would make a
# token minted for GrantPortal verify here too, and the demo's whole claim is
# that it does not.
#
# Local-development placeholder, and a real private key all the same — it is in
# git, so treat it as public. Generate your own for anything that is not
# localhost:
#   node -e 'crypto.subtle.generateKey({name:"ECDSA",namedCurve:"P-256"},true,["sign","verify"]).then(k=>crypto.subtle.exportKey("jwk",k.privateKey)).then(j=>console.log(JSON.stringify({kty:j.kty,crv:j.crv,x:j.x,y:j.y,d:j.d})))'
SIGNING_KEY_JWK={"kty":"EC","crv":"P-256","x":"uNinMMO1E-N4gLEbrWTwilEFVtfBsg_ewR6ODE5cw7k","y":"ZNxoFkHHy4qlxMb4aONCVyPafKQN-nBISzvX7lBa3AU","d":"53yQtrEQXx4_Hmqqa0jvddyuhc3Ebilzpix4CNeqi6s"}

# `true` mounts POST /__test/reset (fixture mode only; sandbox mode answers 409).
ENABLE_TEST_ROUTES=true

# `fake` mounts the stand-in sign-in form; `google` needs the two client values.
IDENTITY_PROVIDER=fake
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# This system's public origin (token issuer, provider callback). Defaults to the request origin.
SYSTEM_ORIGIN=http://localhost:5175

# The only origin an authorization code is sent to.
LINK_ORIGIN=http://localhost:5176

# The demo's two people. Empty leaves the seed placeholders in place.
DEMO_ADMIN_EMAIL=
DEMO_PORTAL_ONLY_EMAIL=
