# Temelio adapter. Copy to `.env` (gitignored). Values are deliberately blank.
#
# Vendor detail lives in the internal spec and in SANDBOX-FINDINGS.local.md
# (gitignored), not here — this repo is public.

# `fixture` answers from an in-memory fake of Temelio's API and needs no other
# TEMELIO_* variable; `pnpm e2e` runs in this mode. `sandbox` talks to the real
# sandbox with the three variables below. Unset means `fixture`.
TEMELIO_MODE=fixture

# Origin of Temelio's backend API, no trailing slash, no `/api`.
TEMELIO_API_ORIGIN=

# The foundation (funder) account the adapter acts as. Every reachable grantee
# route lives under it.
TEMELIO_FOUNDATION_ID=

# A foundation API key (Edit scope), created on the foundation's API Keys page.
# Sent on every request as `X-API-Key`. Not a bearer token.
TEMELIO_API_TOKEN=

# Comma-separated Temelio nonprofit ids this adapter may read and write.
# Every write is refused outside this list, whatever credential the caller
# presented. This is also what the demo admin is granted on sign-in.
TEMELIO_ORG_ALLOWLIST=

# --- The same variables the two portals carry ---

# Static service credential accepted on /common-grants/*, scoped to every org.
CG_ACCESS_TOKEN=

# This system's own private ES256 key as a one-line JWK. Generate one:
#   node -e "crypto.subtle.generateKey({name:'ECDSA',namedCurve:'P-256'},true,['sign','verify']).then(async k=>console.log(JSON.stringify(await crypto.subtle.exportKey('jwk',k.privateKey))))"
SIGNING_KEY_JWK=

# `true` mounts POST /__test/reset (fixture mode only; sandbox mode answers 409).
ENABLE_TEST_ROUTES=true

# `fake` mounts the stand-in sign-in form; `google` needs the two client values.
IDENTITY_PROVIDER=fake
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# This system's public origin (token issuer, provider callback). Defaults to the request origin.
SYSTEM_ORIGIN=http://localhost:5175

# The only origin an authorization code is sent to.
LINK_ORIGIN=http://localhost:5176

# The demo's two people. Empty leaves the seed placeholders in place.
DEMO_ADMIN_EMAIL=
DEMO_PORTAL_ONLY_EMAIL=
