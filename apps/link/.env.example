# The bearer token Link presents to each source. Every system issues its own,
# so these must match that system's own CG_ACCESS_TOKEN — a token lifted from
# one source is useless at another, which is the point of per-system
# credentials. Copy the values from apps/portal/.env and apps/funderhub/.env.
#
# A source whose variable is unset is reported as "no access token is
# configured" in the comparison rather than silently 401ing.
#
# These are local-development placeholders and nothing else. Generate real
# secrets for anything that is not localhost.
PORTAL_ACCESS_TOKEN=portal-local-placeholder-change-me
FUNDERHUB_ACCESS_TOKEN=funderhub-local-placeholder-change-me
