# Link holds no credentials.
#
# Each system issues its own access token through its own OAuth flow, the
# browser keeps them for the session, and Link forwards them on the
# `x-source-tokens` header. Nothing here is a secret.

# The origins allowed to frame the widget, comma-separated.
#
# Two jobs, one list: it becomes the `frame-ancestors` directive the browser
# enforces, and it is the set of `?parent=` origins the widget will post its
# `synced` and `close` messages to. A host that can frame Link is exactly a
# host Link will talk back to.
#
# Unset, Link fails closed — `frame-ancestors 'self'`, so nobody may frame it
# and the widget posts nothing. These two are the portals' dev servers.
EMBED_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
