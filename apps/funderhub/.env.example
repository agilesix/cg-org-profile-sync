# The bearer token this system accepts on /common-grants/* routes. Link holds
# one of these per source. Any non-empty string works for the demo; the guard
# fails closed if it is unset, so every request gets a 401.
#
# This value is a local-development placeholder and nothing else. The point of
# a per-system credential is that one lifted from another system is useless —
# which stops being true the moment two systems share a value anyone can read
# in git. Generate a real secret for anything that is not localhost.
CG_ACCESS_TOKEN=funderhub-local-placeholder-change-me

# Mounts POST /__test/reset, which re-seeds the store between e2e specs.
# Local only — keep it out of wrangler.jsonc `vars` so a deploy cannot set it.
ENABLE_TEST_ROUTES=true

# This system's own ES256 signing key, as a private JWK on one line. It signs
# the access tokens this system mints and backs /.well-known/jwks.json, so a
# token minted here verifies here and nowhere else. Unset, the system verifies
# no tokens and serves no keys — it still accepts CG_ACCESS_TOKEN above, which
# is what keeps the curl block and the API specs working.
#
# Local-development placeholder, and a real private key all the same: it is in
# git, so treat it as public. Generate your own for anything that is not
# localhost:
#   node -e 'crypto.subtle.generateKey({name:"ECDSA",namedCurve:"P-256"},true,["sign","verify"]).then(k=>crypto.subtle.exportKey("jwk",k.privateKey)).then(j=>console.log(JSON.stringify({kty:j.kty,crv:j.crv,x:j.x,y:j.y,d:j.d})))'
SIGNING_KEY_JWK={"kty":"EC","crv":"P-256","x":"zVVH4oveoRSMdn0y5DLLTmIu8ek2R7NsCyk762yeJng","y":"xI2lk7ofUU5a5JTxffyoBnedps7ACrXHEEXu8trlj34","d":"lHIBn4s5cINBop0-4rC3ryDgw1uNMPFKUlAJf65dcBE"}

# Which identity provider the OAuth flow delegates to. `fake` mounts
# GET /oauth/fake-login, a form that stands in for Google so the demo and
# `pnpm e2e` run without a Google account; unset or `google` 404s that route
# and uses the real thing. Keep `fake` out of any deployment.
IDENTITY_PROVIDER=fake

# The Google OAuth client, used when IDENTITY_PROVIDER is not `fake`. One
# "Web application" client, with this system's /oauth/callback as a registered
# redirect URI. Only the portals hold these; Link never sees them.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# This system's own public origin. Used as the token issuer and to build the
# callback URL the identity provider returns to, which Google matches against
# its registered URIs exactly. Falls back to the origin the request arrived on,
# which is what makes a local checkout work unset.
#
# Deliberately not named PUBLIC_ORIGIN: SvelteKit's $env/dynamic/private
# excludes every variable starting with PUBLIC_, so that name would read empty.
SYSTEM_ORIGIN=http://localhost:5174

# Link's origin - the only place this system will send an authorization code,
# which it receives at its own /connect/callback route.
# Unset, no redirect URI is registered and every authorize request is refused.
LINK_ORIGIN=http://localhost:5176

# The addresses the demo's two people sign in with, overriding the seed's
# placeholders (admin@example.org and portal-only@example.org). Set these to
# the real Gmail accounts on the day. Left unset, the placeholders stand - an
# empty value is ignored rather than blanking out an address, since an email
# nobody has is an email with no grants.
DEMO_ADMIN_EMAIL=
DEMO_PORTAL_ONLY_EMAIL=
