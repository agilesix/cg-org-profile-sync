# The bearer token this system accepts on /common-grants/* routes. Link holds
# one of these per source. Any non-empty string works for the demo; the guard
# fails closed if it is unset, so every request gets a 401.
#
# This value is a local-development placeholder and nothing else. The point of
# a per-system credential is that one lifted from another system is useless —
# which stops being true the moment two systems share a value anyone can read
# in git. Generate a real secret for anything that is not localhost.
CG_ACCESS_TOKEN=funderhub-local-placeholder-change-me

# Mounts POST /__test/reset, which re-seeds the store between e2e specs.
# Local only — keep it out of wrangler.jsonc `vars` so a deploy cannot set it.
ENABLE_TEST_ROUTES=true
