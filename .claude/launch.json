{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "website-dev",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "website",
        "run",
        "dev"
      ],
      "port": 4321
    },
    {
      "name": "mock-api-dev",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@common-grants/mock-api",
        "run",
        "dev"
      ],
      "port": 8787
    },
    {
      "name": "website-dev-alt",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "website",
        "exec",
        "astro",
        "dev",
        "--port",
        "4325"
      ],
      "port": 4325,
      "autoPort": false
    },
    {
      "name": "website-built-preview",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd website && pnpm exec wrangler dev --config dist/server/wrangler.json --port 4322"
      ],
      "port": 4322,
      "autoPort": false
    },
    {
      "name": "website-dev-mock",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd website && pnpm exec astro dev --port 4327"
      ],
      "port": 4327,
      "autoPort": false
    }
  ]
}
